{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://impresso.github.io/impresso-keyphrase/schemas/keyphrase/deepseek-summary.schema.json",
  "title": "Keyphrase DeepSeek summary",
  "description": "Token and processing summary emitted by the keyphrase keyword-generation step.",
  "type": "object",
  "required": [
    "input_prefix",
    "output_prefix",
    "providers_title_path",
    "model",
    "base_url",
    "keywords_field",
    "total_records",
    "total_failed_records",
    "total_records_with_keywords",
    "total_article_chars",
    "total_prompt_tokens",
    "total_completion_tokens",
    "total_tokens",
    "languages",
    "languages_summary"
  ],
  "properties": {
    "input_prefix": {
      "type": "string",
      "description": "Input S3 or local prefix containing per-language JSONL files."
    },
    "output_prefix": {
      "type": "string",
      "description": "Output S3 or local prefix containing keyword JSONL files."
    },
    "providers_title_path": {
      "type": "string",
      "description": "Provider/title mapping used to infer publication country."
    },
    "model": {
      "type": "string",
      "description": "Chat model used for keyword generation."
    },
    "base_url": {
      "type": "string",
      "description": "OpenAI-compatible API base URL."
    },
    "keywords_field": {
      "type": "string",
      "description": "Output field name used for generated keyphrases."
    },
    "total_records": {
      "type": "integer",
      "description": "Total records processed.",
      "minimum": 0
    },
    "total_failed_records": {
      "type": "integer",
      "description": "Total records where keyword generation failed.",
      "minimum": 0
    },
    "total_records_with_keywords": {
      "type": "integer",
      "description": "Total records that received at least one keyword.",
      "minimum": 0
    },
    "total_article_chars": {
      "type": "integer",
      "description": "Total article characters submitted to the model.",
      "minimum": 0
    },
    "total_prompt_tokens": {
      "type": "integer",
      "description": "Total prompt tokens reported by the model API.",
      "minimum": 0
    },
    "total_completion_tokens": {
      "type": "integer",
      "description": "Total completion tokens reported by the model API.",
      "minimum": 0
    },
    "total_tokens": {
      "type": "integer",
      "description": "Total tokens reported by the model API.",
      "minimum": 0
    },
    "total_usage_missing_records": {
      "type": "integer",
      "description": "Records for which API usage metadata was missing.",
      "minimum": 0
    },
    "languages": {
      "type": "array",
      "description": "Languages processed by the model.",
      "items": {
        "type": "string",
        "description": "One language code.",
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "languages_summary": {
      "type": "array",
      "description": "Per-language processing and token statistics.",
      "items": {
        "type": "object",
        "required": [
          "language",
          "records",
          "failed_records",
          "records_with_keywords",
          "article_chars",
          "prompt_tokens",
          "completion_tokens",
          "total_tokens",
          "input_path",
          "output_path"
        ],
        "properties": {
          "language": {
            "type": "string",
            "description": "Language code inferred from the input filename."
          },
          "records": {
            "type": "integer",
            "description": "Records processed for this language.",
            "minimum": 0
          },
          "failed_records": {
            "type": "integer",
            "description": "Records that failed for this language.",
            "minimum": 0
          },
          "records_with_keywords": {
            "type": "integer",
            "description": "Records with at least one keyword for this language.",
            "minimum": 0
          },
          "article_chars": {
            "type": "integer",
            "description": "Article characters processed for this language.",
            "minimum": 0
          },
          "prompt_tokens": {
            "type": "integer",
            "description": "Prompt tokens for this language.",
            "minimum": 0
          },
          "completion_tokens": {
            "type": "integer",
            "description": "Completion tokens for this language.",
            "minimum": 0
          },
          "total_tokens": {
            "type": "integer",
            "description": "Total tokens for this language.",
            "minimum": 0
          },
          "input_path": {
            "type": "string",
            "description": "Per-language input JSONL path."
          },
          "output_path": {
            "type": "string",
            "description": "Keyword JSONL output path."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
