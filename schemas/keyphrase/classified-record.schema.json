{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://impresso.github.io/impresso-keyphrase/schemas/keyphrase/classified-record.schema.json",
  "title": "Keyphrase classified record",
  "description": "A record classified by the Impresso ad classifier for the keyphrase sampling pipeline.",
  "type": "object",
  "required": ["id", "tp", "ad_class"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Impresso content item identifier.",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z]{1,3}-i[0-9]{4}$"
    },
    "tp": {
      "type": ["string", "null"],
      "description": "Content item type from the upstream corpus."
    },
    "lg": {
      "type": ["string", "null"],
      "description": "ISO language code assigned upstream.",
      "pattern": "^[a-z]{2,3}$"
    },
    "len": {
      "type": "integer",
      "description": "Text length reported by the upstream corpus or compiler.",
      "minimum": 0
    },
    "ft": {
      "type": "string",
      "description": "Full text used by the classifier when available."
    },
    "title": {
      "type": ["string", "null"],
      "description": "Article title when available."
    },
    "ad_class": {
      "type": "string",
      "description": "Impresso ad-classifier decision.",
      "enum": ["ad", "non-ad"]
    }
  },
  "additionalProperties": true
}
