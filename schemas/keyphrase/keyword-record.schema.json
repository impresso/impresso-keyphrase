{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://impresso.github.io/impresso-keyphrase/schemas/keyphrase/keyword-record.schema.json",
  "title": "Keyphrase keyword record",
  "description": "A per-language article record enriched with English conceptual keyphrases generated by a DeepSeek-compatible chat model.",
  "type": "object",
  "required": ["id", "lg", "ft", "keywords"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Impresso content item identifier.",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z]{1,3}-i[0-9]{4}$"
    },
    "lg": {
      "type": "string",
      "description": "ISO language code of the source article.",
      "pattern": "^[a-z]{2,3}$"
    },
    "title": {
      "type": ["string", "null"],
      "description": "Article title when available."
    },
    "ft": {
      "type": "string",
      "description": "Full text used for keyword generation.",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "description": "English conceptual keyphrases generated for the article.",
      "items": {
        "type": "string",
        "description": "One generated English keyphrase.",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
